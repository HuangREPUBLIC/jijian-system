.page {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.style-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--bg);
  flex: none;
}
.sum-bar {
  display: flex;
  margin: 0 24rpx 24rpx;
  background: var(--blue);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.sum-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
}
.sum-num {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}
.sum-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.field-label-row .field-label {
  margin-bottom: 0;
}
.add-option {
  font-size: 12px;
  color: var(--blue);
}
.img-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius);
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--line);
}
.img-picker-plus {
  font-size: 44rpx;
  color: var(--ink-3);
  line-height: 1;
}
.img-picker-text {
  font-size: 11px;
  color: var(--ink-2);
  margin-top: 4rpx;
}
.img-picker-preview {
  width: 160rpx;
  height: 160rpx;
  position: relative;
}
.img-picker-preview-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius);
}
.img-picker-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bad);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
