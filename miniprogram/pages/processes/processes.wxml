<view class="page">
  <view class="summary-bar">
    <view class="summary-item">
      <view class="summary-value">{{totalCount}}</view>
      <view class="summary-label">工序数量</view>
    </view>
    <view class="summary-item">
      <view class="summary-value">{{totalPrice}}</view>
      <view class="summary-label">单价合计（元）</view>
    </view>
  </view>
  <view class="card">
    <view class="row-item" wx:for="{{processes}}" wx:key="id" bindtap="editItem" data-item="{{item}}">
      <view class="row-left">
        <view class="row-seq">{{index + 1}}</view>
        <view class="row-main">
          <view class="row-value">{{item.name}}</view>
          <view class="row-label">标准定额 {{item.std_qty}}{{item.unit}} · 小时定额 {{item.hour_quota}}<block wx:if="{{item.unit_price}}"> · 单价 {{item.unit_price}}元</block></view>
        </view>
      </view>
      <view class="btn-danger" catchtap="remove" data-id="{{item.id}}">删除</view>
    </view>
    <view wx:if="{{processes.length === 0}}" class="empty">还没有工序模板</view>
  </view>
  <view class="btn-primary" bindtap="toggleForm">{{showForm ? '取消' : '新增工序模板'}}</view>

  <view class="card" wx:if="{{showForm}}">
    <view class="field">
      <view class="field-label">工序名称</view>
      <input class="input" value="{{name}}" bindinput="onName" />
    </view>
    <view class="field">
      <view class="field-label">单位（如：个）</view>
      <input class="input" value="{{unit}}" bindinput="onUnit" />
    </view>
    <view class="field">
      <view class="field-label">标准定额</view>
      <input class="input" type="digit" value="{{stdQty}}" bindinput="onStdQty" />
    </view>
    <view class="field">
      <view class="field-label">小时定额</view>
      <input class="input" type="digit" value="{{hourQuota}}" bindinput="onHourQuota" />
    </view>
    <view class="field">
      <view class="field-label">计件单价（元/件，选填，薪资管理要用）</view>
      <input class="input" type="digit" value="{{unitPrice}}" bindinput="onUnitPrice" />
    </view>
  </view>
  <view class="btn-primary" wx:if="{{showForm}}" bindtap="submit">保存</view>
</view>
